{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../apps/youtube-transcript-mcp/dist",
    "module": "node20",
    "types": ["node"],
    "rootDir": "../../",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "lib/**/*.ts","../../libs/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
}
